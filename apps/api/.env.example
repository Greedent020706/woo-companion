PORT=4000

# mock = datos de ejemplo en memoria | woo = tienda WooCommerce real
DATA_SOURCE=mock

# Cambia este valor por una cadena larga y aleatoria. Obligatorio en producción.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Orígenes que pueden llamar a la API, separados por comas
CORS_ORIGINS=http://localhost:5173

# Solo para DATA_SOURCE=woo
WOO_URL=https://tu-tienda.com
WOO_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
